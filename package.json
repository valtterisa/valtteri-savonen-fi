{
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "start": "bash scripts/dev.sh",
    "build": "pnpm css && mkdir -p bin && go build -o bin/server ./backend/cmd/server",
    "css": "tailwindcss -i css/input.css -o css/output.css --minify",
    "css:watch": "tailwindcss -i css/input.css -o css/output.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/typography": "^0.5.16",
    "tailwindcss": "^4.3.3"
  }
}
