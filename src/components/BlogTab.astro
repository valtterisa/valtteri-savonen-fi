---
import type { Post } from "../lib/marble";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <div class="text-gray-400">no blog posts, yet.</div>
  ) : (
    <ul class="space-y-3">
      {posts.map((post) => (
        <li class="flex items-start gap-3">
          <span
            aria-hidden="true"
            class="mt-[0.55rem] h-1.5 w-1.5 shrink-0 rounded-full bg-gray-500"
          />
          <a
            href={`/blog/${post.slug}`}
            class="text-gray-400 hover:text-white transition-colors"
          >
            <span class="text-base font-medium text-white lowercase">
              {post.title || "Untitled Post"}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}
