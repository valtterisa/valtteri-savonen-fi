---
import type { ContributionGraph } from "../lib/contrib";

interface Props {
  graph: ContributionGraph;
}

const { graph } = Astro.props;
---

{
  graph.days.length > 0 && (
    <>
      <div class="contrib-block">
        <div class="contrib-frame">
          <div class="contrib-scroll">
            <div class="contrib">
              {graph.days.map((day) => (
                <span
                  class={`l${day.level}`}
                  data-tip={day.tip}
                  aria-label={day.tip}
                />
              ))}
            </div>
          </div>
          <div class="contrib-fade contrib-fade-left" />
          <div class="contrib-fade contrib-fade-right" />
        </div>
        <p class="contrib-caption">
          {graph.caption} ·{" "}
          <a
            href="https://github.com/valtterisa"
            target="_blank"
            rel="noopener noreferrer"
            class="contrib-source"
          >
            source
          </a>
        </p>
      </div>
      <div id="contrib-tip" class="contrib-tip" hidden />
    </>
  )
}

<script>
  function initContrib() {
    const el = document.querySelector<HTMLElement>(".contrib-scroll");
    const frame = document.querySelector<HTMLElement>(".contrib-frame");
    const tip = document.getElementById("contrib-tip");
    if (!el || el.dataset.ready) return;
    el.dataset.ready = "1";

    function syncFade() {
      if (!frame) return;
      const noScroll = el.scrollWidth <= el.clientWidth + 2;
      const atStart = noScroll || el.scrollLeft <= 2;
      const atEnd =
        noScroll || el.scrollLeft + el.clientWidth >= el.scrollWidth - 2;
      frame.classList.toggle("at-start", atStart);
      frame.classList.toggle("at-end", atEnd);
    }

    el.scrollLeft = el.scrollWidth;
    syncFade();

    el.addEventListener(
      "wheel",
      (event) => {
        if (el.scrollWidth <= el.clientWidth) return;
        el.scrollLeft += event.deltaY + event.deltaX;
        event.preventDefault();
      },
      { passive: false },
    );

    el.addEventListener("mouseover", (event) => {
      const target = (event.target as HTMLElement | null)?.closest(
        "[data-tip]",
      );
      if (!target || !tip) return;
      const rect = target.getBoundingClientRect();
      tip.textContent = target.getAttribute("data-tip");
      tip.style.left = `${rect.left + rect.width / 2}px`;
      tip.style.top = `${rect.top}px`;
      tip.hidden = false;
    });

    el.addEventListener("mouseout", (event) => {
      if (!tip) return;
      const related = event.relatedTarget as Node | null;
      if (related && el.contains(related)) return;
      tip.hidden = true;
    });

    el.addEventListener("scroll", () => {
      if (tip) tip.hidden = true;
      syncFade();
    });
  }

  initContrib();
  document.addEventListener("astro:after-swap", initContrib);
</script>
