---
import type { Experience } from "../lib/content";

interface Props {
  experiences: Experience[];
}

const { experiences } = Astro.props;
---

<div class="space-y-8">
  {
    experiences.map((experience) => (
      <div>
        <div class="flex justify-between items-start mb-2">
          <div>
            <h3 class="text-lg font-semibold">{experience.title}</h3>
            <p class="text-gray-400 text-sm">{experience.company}</p>
          </div>
          <span class="text-sm text-gray-500">{experience.period}</span>
        </div>
        <p class="text-gray-400 text-sm mb-3">{experience.description}</p>
        {experience.technologies && (
          <div class="flex flex-wrap gap-2 text-sm text-gray-500">
            {experience.technologies.map((tech, index) => (
              <span>
                {tech}
                {index < experience.technologies!.length - 1 ? " /" : ""}
              </span>
            ))}
          </div>
        )}
      </div>
    ))
  }
</div>
