---
import BaseLayout from "../layouts/BaseLayout.astro";
import { notFoundSeo } from "../lib/seo";
---

<BaseLayout seo={notFoundSeo(Astro.url.pathname)}>
  <div
    class="min-h-screen flex flex-col items-center justify-center gap-4 px-6"
  >
    <h1 class="text-2xl font-bold">404</h1>
    <p class="text-gray-400">Page not found.</p>
    <a
      href="/"
      class="text-gray-300 hover:text-white underline underline-offset-2"
      >Go home</a
    >
  </div>
</BaseLayout>
