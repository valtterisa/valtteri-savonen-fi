---
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPost,
  getAuthor,
  formatPublished,
} from "../../lib/marble";
import { blogPostSeo, blogNotFoundSeo } from "../../lib/seo";

const slug = Astro.params.slug;
const post = slug ? await getPost(slug) : null;

if (!post) {
  Astro.response.status = 404;
}

const author = post ? getAuthor(post) : { name: "Valtteri Savonen", image: "" };
const seo = post
  ? blogPostSeo(slug!, post, author.name)
  : blogNotFoundSeo(slug ?? "");

if (post) {
  Astro.response.headers.set(
    "Cache-Control",
    "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400",
  );
}
---

<BaseLayout seo={seo}>
  <div class="w-full py-10 sm:py-12 px-4 sm:px-8 md:px-16 relative">
    <a
      href="/?tab=blog"
      class="absolute top-6 left-6 text-gray-400 text-sm hover:text-white transition-colors"
      >← Back to homepage</a
    >

    {
      !post ? (
        <div class="max-w-3xl mx-auto pt-8">
          <p class="text-gray-400">Post not found.</p>
        </div>
      ) : (
        <article class="max-w-3xl mx-auto pt-8">
          <header class="mb-8">
            <h1 class="text-3xl sm:text-4xl font-bold text-white mb-4 leading-tight lowercase">
              {post.title}
            </h1>

            <div class="flex items-center gap-3 text-sm text-gray-500 mb-4">
              {author.image && (
                <img
                  src={author.image}
                  alt={author.name}
                  class="w-8 h-8 rounded-full object-cover"
                />
              )}
              <div class="flex-1">
                <div class="text-white">{author.name}</div>
                {post.publishedAt && (
                  <time datetime={post.publishedAt}>
                    {formatPublished(post.publishedAt)}
                  </time>
                )}
              </div>
            </div>

            {post.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {post.tags.map((tag) => (
                  <span class="px-2 py-0.5 text-xs text-gray-400 bg-gray-800 rounded-full">
                    {tag.name || tag.slug}
                  </span>
                ))}
              </div>
            )}
          </header>

          <div
            class="prose prose-invert prose-base max-w-none
        prose-headings:text-white prose-headings:font-bold prose-headings:mt-8 prose-headings:mb-4
        prose-h1:text-3xl prose-h1:font-bold prose-h1:mt-10 prose-h1:mb-5
        prose-h2:text-2xl prose-h2:font-bold prose-h2:mt-8 prose-h2:mb-4
        prose-h3:text-xl prose-h3:font-semibold prose-h3:mt-6 prose-h3:mb-3
        prose-p:text-gray-300 prose-p:leading-relaxed prose-p:mb-6 prose-p:text-base
        prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline prose-a:font-medium
        prose-strong:text-white prose-strong:font-semibold
        prose-code:text-gray-300 prose-code:bg-gray-800 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-code:text-sm prose-code:font-mono
        prose-pre:bg-gray-900 prose-pre:border prose-pre:border-gray-800 prose-pre:rounded-lg prose-pre:p-3 prose-pre:overflow-x-auto prose-pre:my-4
        prose-blockquote:border-l-4 prose-blockquote:border-l-gray-700 prose-blockquote:text-gray-400 prose-blockquote:pl-4 prose-blockquote:italic prose-blockquote:my-4
        prose-img:rounded-lg prose-img:my-5 prose-img:w-full prose-img:h-auto
        prose-ul:text-gray-300 prose-ul:my-4 prose-ul:pl-5
        prose-ol:text-gray-300 prose-ol:my-4 prose-ol:pl-5
        prose-li:text-gray-300 prose-li:my-1.5 prose-li:leading-relaxed
        prose-hr:border-gray-800 prose-hr:my-5"
            set:html={post.content}
          />
        </article>
      )
    }
  </div>
</BaseLayout>
