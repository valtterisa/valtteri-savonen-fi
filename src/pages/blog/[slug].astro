---
export const prerender = false;

import BaseLayout from "../../layouts/base-layout.astro";
import {
  BlogPostPage,
  BlogPostNotFound,
} from "../../components/blog/blog-post-page";
import { ThemeSwitcher } from "../../components/theme-switcher";
import {
  getPost,
  getAuthor,
  formatPublished,
} from "../../lib/marble";
import { blogPostSeo, blogNotFoundSeo } from "../../lib/seo";

const slug = Astro.params.slug;
const post = slug ? await getPost(slug) : null;

if (!post) {
  Astro.response.status = 404;
}

const author = post ? getAuthor(post) : { name: "Valtteri Savonen", image: "" };
const seo = post
  ? blogPostSeo(slug!, post, author.name)
  : blogNotFoundSeo(slug ?? "");

---

<BaseLayout seo={seo}>
  {
    post ? (
      <BlogPostPage
        post={post}
        authorName={author.name}
        authorImage={author.image}
        publishedDisplay={formatPublished(post.publishedAt)}
      >
        <ThemeSwitcher client:load />
      </BlogPostPage>
    ) : (
      <BlogPostNotFound>
        <ThemeSwitcher client:load />
      </BlogPostNotFound>
    )
  }
</BaseLayout>
