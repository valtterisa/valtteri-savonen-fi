---
export const prerender = false;

import BaseLayout from "../layouts/BaseLayout.astro";
import { HomePage } from "../components/home/HomePage";
import {
  projects,
  experiences,
  normalizeTab,
} from "../lib/content";
import { getContributionGraph } from "../lib/contrib";
import { tabSeo } from "../lib/seo";

const activeTab = normalizeTab(Astro.url.searchParams.get("tab"));
const graph = await getContributionGraph();
const seo = tabSeo(activeTab);
---

<BaseLayout seo={seo}>
  <HomePage
    client:load
    activeTab={activeTab}
    graph={graph}
    projects={projects}
    experiences={experiences}
  />
</BaseLayout>
