---
export const prerender = false;

import BaseLayout from "../layouts/base-layout.astro";
import ContributionGraphIsland from "../components/contrib/contribution-graph-island.astro";
import { HomePage } from "../components/home/home-page";
import { normalizeTab } from "../lib/content";
import { listPosts } from "../lib/marble";
import { tabSeo } from "../lib/seo";

const activeTab = normalizeTab(Astro.url.searchParams.get("tab"));
const posts = await listPosts();
const seo = tabSeo(activeTab);
const initialPosts = posts.map((post) => ({
  id: post.id,
  slug: post.slug,
  title: post.title,
}));
---

<BaseLayout seo={seo}>
  <HomePage
    client:load
    activeTab={activeTab}
    initialPosts={initialPosts}
  >
    <ContributionGraphIsland server:defer slot="contrib-graph">
      <div slot="fallback" class="contrib-block contrib-block--fallback" aria-hidden="true" />
    </ContributionGraphIsland>
  </HomePage>
</BaseLayout>
